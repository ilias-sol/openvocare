<Window x:Class="OpenVocare.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="28" Height="20" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="IndicatorBrush" Color="#3D434D" />
        <Storyboard x:Key="RecordingAnimation">
            <DoubleAnimation Storyboard.TargetName="WaveScale1" Storyboard.TargetProperty="ScaleY"
                             From="0.45" To="0.9" Duration="0:0:0.30" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale2" Storyboard.TargetProperty="ScaleY"
                             From="0.55" To="1" Duration="0:0:0.24" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale3" Storyboard.TargetProperty="ScaleY"
                             From="0.35" To="0.85" Duration="0:0:0.34" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale4" Storyboard.TargetProperty="ScaleY"
                             From="0.6" To="1" Duration="0:0:0.27" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale5" Storyboard.TargetProperty="ScaleY"
                             From="0.4" To="0.8" Duration="0:0:0.31" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="TranscribingAnimation">
            <DoubleAnimation Storyboard.TargetName="DotMove1" Storyboard.TargetProperty="Y"
                             From="1" To="-3" Duration="0:0:0.34" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="DotMove2" Storyboard.TargetProperty="Y"
                             From="1" To="-3" BeginTime="0:0:0.11" Duration="0:0:0.34" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="DotMove3" Storyboard.TargetProperty="Y"
                             From="1" To="-3" BeginTime="0:0:0.22" Duration="0:0:0.34" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <StackPanel x:Name="RecordingWave" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="2" Height="8" Margin="1,0" CornerRadius="1" Background="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="WaveScale1" /></Border.RenderTransform>
            </Border>
            <Border Width="2" Height="13" Margin="1,0" CornerRadius="1" Background="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="WaveScale2" /></Border.RenderTransform>
            </Border>
            <Border Width="2" Height="17" Margin="1,0" CornerRadius="1" Background="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="WaveScale3" /></Border.RenderTransform>
            </Border>
            <Border Width="2" Height="12" Margin="1,0" CornerRadius="1" Background="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="WaveScale4" /></Border.RenderTransform>
            </Border>
            <Border Width="2" Height="7" Margin="1,0" CornerRadius="1" Background="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="WaveScale5" /></Border.RenderTransform>
            </Border>
        </StackPanel>

        <Grid x:Name="TranscribingDots" Visibility="Collapsed" Width="22" Height="12"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" Width="4" Height="4" Fill="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><TranslateTransform x:Name="DotMove1" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Grid.Column="1" Width="4" Height="4" Fill="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><TranslateTransform x:Name="DotMove2" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Grid.Column="2" Width="4" Height="4" Fill="{StaticResource IndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><TranslateTransform x:Name="DotMove3" /></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
    </Grid>
</Window>
