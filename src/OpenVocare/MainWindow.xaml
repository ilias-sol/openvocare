<Window x:Class="OpenVocare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenVocare" AutomationProperties.Name="OpenVocare"
        Width="1000" Height="720" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#E7EAEF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True" Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#4C4F69" />
        <SolidColorBrush x:Key="Muted" Color="#77798D" />
        <SolidColorBrush x:Key="Line" Color="#DDE1E8" />
        <SolidColorBrush x:Key="Accent" Color="#343A44" />
        <BitmapImage x:Key="AppIcon"
                     UriSource="pack://application:,,,/OpenVocare;component/Assets/OpenVocare.png"
                     CacheOption="OnLoad" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DFE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="field" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="field" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="field" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="field" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DFE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ToggleButton HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,34,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="#6D7788"
                                                      Width="8" Height="4" HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" Margin="0,0,14,0" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0" Background="White"
                                        BorderBrush="#D9DFE8" BorderThickness="1"
                                        CornerRadius="8" Padding="4">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="item" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="item" Property="Background" Value="#E8EAED" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="item" Property="Background" Value="#DDE0E4" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DFE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#F1F4F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#E8EDF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#343A44" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#454B55" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#292E36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RewriteModeCard" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#F4F6F9" />
                                <Setter TargetName="surface" Property="BorderBrush" Value="#BFC6D1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#EEF0F4" />
                                <Setter TargetName="surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="surface" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RewriteCardIcon" TargetType="Path">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource Ink}" />
            <Setter Property="StrokeThickness" Value="1.45" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{StaticResource Ink}"
                                              TextElement.FontSize="14"
                                              TextElement.FontWeight="SemiBold"
                                              Margin="0,0,0,12" />
                            <Border Background="#FAFBFC" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="16" Padding="20">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="track" Width="34" Height="20" CornerRadius="10"
                                    Background="#CBD3DE" Margin="0,0,9,0">
                                <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#AEB9C9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModifierChoice" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="pill" Background="White" BorderBrush="#D9DFE8"
                                BorderThickness="1" CornerRadius="9" Padding="11,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#F1F4F8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#E5E7EA" />
                                <Setter TargetName="pill" Property="BorderBrush" Value="#858C97" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="SettingsRowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsRowDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource Line}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#E8EAF0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#DDE1E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActiveTabButton" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Background" Value="#E3E6EC" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <Style x:Key="SettingsScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Width="5"
                                HorizontalAlignment="Right"
                                Background="#7A808A" Opacity="0.48"
                                CornerRadius="3" Margin="0,2,2,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.72" />
                                <Setter TargetName="ThumbSurface" Property="Width" Value="6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.9" />
                                <Setter TargetName="ThumbSurface" Property="Width" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Background="#E7EAEF">
            <Grid>
                <DockPanel LastChildFill="True" Margin="24,28">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="46" Height="32" Source="{StaticResource AppIcon}"
                                   Stretch="UniformToFill" Margin="-6,0,4,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="OpenVocare"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontWeight="SemiBold" FontSize="17" />
                                <TextBlock Text="Voice input for Windows" Foreground="{StaticResource Muted}"
                                           FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#F8F9FB" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="11" Padding="13"
                                Margin="0,34,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#53D58A"
                                             VerticalAlignment="Top" Margin="0,4,8,0" />
                                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="Use your shortcut to start dictation and paste."
                                           Foreground="{StaticResource Muted}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="AT A GLANCE" Foreground="{StaticResource Muted}" FontSize="10"
                                   FontWeight="SemiBold" Margin="0,32,0,10" />
                        <Border Background="#F8F9FB" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="11" Padding="13">
                            <StackPanel>
                                <TextBlock Text="Subscription transcription" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ConnectionStatusText" Text="Checking sign-in..."
                                           Foreground="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F8F9FB" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="11" Padding="13"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Activation shortcuts" FontWeight="SemiBold" />
                                <StackPanel x:Name="KeyboardShortcutSummaryRow" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="KEYBOARD" Foreground="{StaticResource Muted}"
                                                   FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="KeyboardActivationSummaryText" Grid.Column="1"
                                                   Text="Hold to talk" Foreground="{StaticResource Muted}"
                                                   FontSize="9" />
                                    </Grid>
                                    <TextBlock x:Name="KeyboardShortcutSummaryText"
                                               Text="Ctrl + Alt + Space" FontWeight="SemiBold"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border x:Name="ShortcutSummaryDivider" Height="1"
                                        Background="{StaticResource Line}" Margin="0,10" />
                                <StackPanel x:Name="MouseShortcutSummaryRow">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="MOUSE" Foreground="{StaticResource Muted}"
                                                   FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MouseActivationSummaryText" Grid.Column="1"
                                                   Text="Hold to talk" Foreground="{StaticResource Muted}"
                                                   FontSize="9" />
                                    </Grid>
                                    <TextBlock x:Name="MouseShortcutSummaryText"
                                               Text="Forward side button" FontWeight="SemiBold"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="PrivacySummaryText" DockPanel.Dock="Bottom"
                               Text="No local model, API key, transcript history, or saved audio."
                               Foreground="{StaticResource Muted}" FontSize="11"
                               TextWrapping="Wrap" Margin="14,14,8,0" />
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#F2F3F6" CornerRadius="14,0,0,0" />
        <Grid Grid.Column="1" Margin="36,28,36,24"
              MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock x:Name="PageTitle" Text="Settings"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="25" FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle"
                           Text="Configure dictation, shortcuts, and app behavior."
                           Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="SettingsTabButton" Content="Settings"
                            Style="{StaticResource ActiveTabButton}" Click="SettingsTab_Click" />
                    <Button x:Name="HistoryTabButton" Content="History"
                            Style="{StaticResource TabButton}" Click="HistoryTab_Click" />
                    <Button x:Name="RewriteTabButton" Content="Rewrite"
                            Style="{StaticResource TabButton}" Click="RewriteTab_Click" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="SettingsView" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource SettingsScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Input" Style="{StaticResource SettingsSectionLabel}" />
                    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="190" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Microphone" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Choose the input used for dictation."
                                               Style="{StaticResource SettingsRowDescription}" />
                                    <TextBlock x:Name="MicrophoneStatusText"
                                               Text="Loading microphones..."
                                               Foreground="{StaticResource Muted}" FontSize="11"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="MicrophoneBox" Width="240"
                                              SelectedValuePath="DeviceId"
                                              SelectionChanged="SettingsControl_Changed" />
                                    <Button Content="Refresh" Height="36" Margin="8,0,0,0"
                                            Click="RefreshMicrophones_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ChatGPT connection"
                                                   Style="{StaticResource SettingsRowTitle}" />
                                        <TextBlock Text="·"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="7,0" />
                                        <TextBlock x:Name="ConnectionReadinessTitle"
                                                   Text="Checking"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="ConnectionReadinessDescription"
                                               Text="Checking your ChatGPT sign-in..."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <Button x:Name="CheckReadinessButton" Grid.Column="1"
                                        Content="Check again"
                                        VerticalAlignment="Center" Click="CheckConnection_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Shortcuts" Style="{StaticResource SettingsSectionLabel}" />
                    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Keyboard shortcut" Style="{StaticResource SettingsRowTitle}" />
                                     <TextBlock x:Name="KeyboardShortcutDescriptionText"
                                                Text="Hold while speaking, then focus the destination and release to transcribe and paste."
                                                Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="KeyboardShortcutEnabled" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="KeyboardShortcutEnabled_Changed"
                                          Unchecked="KeyboardShortcutEnabled_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Keyboard activation" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock x:Name="KeyboardActivationDescriptionText"
                                               Text="Keep the shortcut held while speaking."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="KeyboardActivationModeBox" Grid.Column="1" Width="180"
                                          DisplayMemberPath="Name" SelectedValuePath="Mode"
                                          SelectionChanged="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Shortcut keys" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock x:Name="ShortcutCaptureHintText"
                                               Text="Press Change, then use your preferred combination."
                                               Style="{StaticResource SettingsRowDescription}" />
                                    <TextBlock x:Name="ShortcutValidationText" Foreground="#B42318"
                                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel x:Name="ShortcutEditControls" Grid.Column="1"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="ShortcutKeycapsPanel"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                    <Button x:Name="ChangeShortcutButton" Content="Change"
                                            Click="ChangeShortcut_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Mouse shortcut" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Optionally use a side button instead of the keyboard."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="MouseButtonBox" Grid.Column="1" Width="220"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="Name" SelectedValuePath="Button"
                                          SelectionChanged="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid x:Name="MouseActivationRow" Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Mouse activation" Style="{StaticResource SettingsRowTitle}" />
                                     <TextBlock x:Name="MouseActivationDescriptionText"
                                                Text="Keep the side button held, then focus the destination and release."
                                                Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="MouseActivationModeBox" Grid.Column="1" Width="180"
                                          DisplayMemberPath="Name" SelectedValuePath="Mode"
                                          SelectionChanged="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid x:Name="BlockBrowserNavigationRow" Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Block browser navigation"
                                               Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Suppress the mouse button's normal Back or Forward action."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="ConsumeMouseButton" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="General" Style="{StaticResource SettingsSectionLabel}" />
                    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Error notifications" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Show a notification when dictation or text delivery fails."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="ErrorNotificationsEnabled" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Completion notifications"
                                               Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Show a notification after text is pasted successfully."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="CompletionNotificationsEnabled" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Restore previous clipboard"
                                               Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="After a successful automatic paste, restore what was on the clipboard. New clipboard changes are never overwritten."
                                               Style="{StaticResource SettingsRowDescription}"
                                               MaxWidth="520" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox x:Name="RestorePreviousClipboard" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Maximum recording length"
                                               Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Stops and transcribes automatically. Longer recordings use more memory and take longer to process."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="RecordingLimitBox" Grid.Column="1"
                                          Width="180" VerticalAlignment="Center"
                                          DisplayMemberPath="Name" SelectedValuePath="Minutes"
                                          SelectionChanged="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Start at sign-in" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Launch OpenVocare when you sign in to Windows."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="LaunchAtLogin" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Close button" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Quit the app instead of hiding it in the tray."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="CloseButtonQuits" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Diagnostic logs" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Open local logs for troubleshooting."
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open logs"
                                        VerticalAlignment="Center" Click="OpenLogs_Click" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <StackPanel>
                                    <TextBlock Text="Data handling" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Audio is held in memory, sent to OpenAI for transcription, then discarded. Rewrites send the transcript to OpenAI a second time. Delivered text remains on the Windows clipboard unless restoration is enabled; optional history is stored locally."
                                               Style="{StaticResource SettingsRowDescription}"
                                               LineHeight="16" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="16,13">
                                <StackPanel>
                                    <TextBlock Text="About OpenVocare" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock x:Name="AboutVersionText"
                                               Text="Version 1.0.0 · Unofficial ChatGPT desktop integration"
                                               Style="{StaticResource SettingsRowDescription}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="SettingsFooter" Grid.Row="2" Background="#F2F3F6" Padding="0,18,0,0">
                <TextBlock x:Name="AutoSaveText" Text="Changes are saved automatically."
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </Border>

            <Grid x:Name="HistoryView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,16,14" HorizontalAlignment="Stretch">
                    <Button x:Name="ClearHistoryButton" DockPanel.Dock="Right"
                            Content="Clear history" Click="ClearHistory_Click" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="Save history" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" Margin="0,0,9,0" />
                        <CheckBox x:Name="HistoryEnabled" VerticalAlignment="Center"
                                  Checked="HistoryEnabled_Changed"
                                  Unchecked="HistoryEnabled_Changed" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Transcript history" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="HistorySavingStateText"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                    <ScrollViewer HorizontalContentAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource SettingsScrollBar}" />
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="HistoryList" Margin="0,0,16,0"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SettingsCard}" Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       LineHeight="19" Margin="0,0,0,12" />
                                            <DockPanel Grid.Row="1">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Copy" Padding="10,5"
                                                            Click="CopyHistory_Click" />
                                                    <Button Content="Delete" Padding="10,5" Margin="6,0,0,0"
                                                            Click="DeleteHistory_Click" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DisplayTime}"
                                                           Foreground="{StaticResource Muted}"
                                                           FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="HistoryEmptyState" Style="{StaticResource SettingsCard}"
                            Padding="28" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="No transcripts yet" FontSize="16"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="HistoryEmptyDescription"
                                       Text="Turn on Save history above to keep successful transcripts on this device."
                                       Foreground="{StaticResource Muted}" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="RewriteView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Rewrite after transcription"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Choose what happens between transcription and paste."
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,16" />

                        <TextBlock Text="Rewrite mode" Style="{StaticResource SettingsSectionLabel}" />
                        <UniformGrid Columns="3" Margin="-6,0,-6,10">
                            <ToggleButton x:Name="RewriteVerbatimCard" Tag="Verbatim"
                                          Style="{StaticResource RewriteModeCard}"
                                          Click="RewriteModeCard_Click">
                                <Grid>
                                    <StackPanel Margin="0,0,30,0">
                                        <TextBlock Text="No rewrite" FontWeight="SemiBold" />
                                        <TextBlock Text="Exact transcript. Fastest option." Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Path Style="{StaticResource RewriteCardIcon}"
                                          Data="M2,2 L14,14 M14,2 L2,14" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="RewriteMinimalCard" Tag="Minimal"
                                          Style="{StaticResource RewriteModeCard}"
                                          Click="RewriteModeCard_Click">
                                <Grid>
                                    <StackPanel Margin="0,0,30,0">
                                        <TextBlock Text="Minimal cleanup" FontWeight="SemiBold" />
                                        <TextBlock Text="Remove filler and obvious errors." Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Path Style="{StaticResource RewriteCardIcon}"
                                          Data="M2,13 L10.5,4.5 L13.5,7.5 L5,16 L2,16 Z M9,6 L12,9" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="RewriteProfessionalCard" Tag="Professional"
                                          Style="{StaticResource RewriteModeCard}"
                                          Click="RewriteModeCard_Click">
                                <Grid>
                                    <StackPanel Margin="0,0,30,0">
                                        <TextBlock Text="Professional" FontWeight="SemiBold" />
                                        <TextBlock Text="Clear, polite, work-ready wording." Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Path Style="{StaticResource RewriteCardIcon}"
                                          Data="M5,2 L11,2 L10,5 L8,7 L6,5 Z M8,7 L11,14 L8,16 L5,14 Z" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="RewriteRambleCard" Tag="Ramble"
                                          Style="{StaticResource RewriteModeCard}"
                                          Click="RewriteModeCard_Click">
                                <Grid>
                                    <StackPanel Margin="0,0,30,0">
                                        <TextBlock Text="Clear thoughts" FontWeight="SemiBold" />
                                        <TextBlock Text="Turn brainstorming into structure." Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Path Style="{StaticResource RewriteCardIcon}"
                                          Data="M2,3 L3,3 M6,3 L15,3 M2,8 L3,8 M6,8 L15,8 M2,13 L3,13 M6,13 L15,13" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="RewriteTranslateCard" Tag="Translate"
                                          Style="{StaticResource RewriteModeCard}"
                                          Click="RewriteModeCard_Click">
                                <Grid>
                                    <StackPanel Margin="0,0,30,0">
                                        <TextBlock Text="Translate" FontWeight="SemiBold" />
                                        <TextBlock Text="Translate into another language." Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Path Style="{StaticResource RewriteCardIcon}"
                                          Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M1,8 L15,8 M8,1 C11,4 11,12 8,15 M8,1 C5,4 5,12 8,15" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="RewriteCustomCard" Tag="Custom"
                                          Style="{StaticResource RewriteModeCard}"
                                          Click="RewriteModeCard_Click">
                                <Grid>
                                    <StackPanel Margin="0,0,30,0">
                                        <TextBlock Text="Custom" FontWeight="SemiBold" />
                                        <TextBlock Text="Use your saved writing profile." Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Path Style="{StaticResource RewriteCardIcon}"
                                          Data="M3,13 L4,9 L11,2 L14,5 L7,12 Z M10,3 L13,6 M3,13 L2,16 L5,15" />
                                </Grid>
                            </ToggleButton>
                        </UniformGrid>

                        <ComboBox x:Name="RewriteModeBox" Visibility="Collapsed"
                                  DisplayMemberPath="Name" SelectedValuePath="Mode"
                                  SelectionChanged="RewriteMode_Changed" />

                        <Border Style="{StaticResource SettingsCard}" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="RewriteModeTitle" Text="No rewrite"
                                           FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="RewriteModeDescription"
                                           Text="Pastes the transcription exactly as ChatGPT returns it, with no added latency."
                                           Style="{StaticResource SettingsRowDescription}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />

                                <Grid x:Name="TranslationLanguageRow" Margin="0,16,0,0"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Target language" Style="{StaticResource SettingsRowTitle}" />
                                        <TextBlock Text="Enter a language such as English, German, or Japanese."
                                                   Style="{StaticResource SettingsRowDescription}" />
                                    </StackPanel>
                                    <TextBox x:Name="TranslationLanguageBox" Grid.Column="1"
                                             Width="220" VerticalContentAlignment="Center"
                                             MaxLength="80"
                                             TextChanged="RewriteText_Changed"
                                             LostKeyboardFocus="RewriteText_LostKeyboardFocus" />
                                </Grid>

                                <StackPanel x:Name="CustomProfileSection" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsDivider}" Margin="0,16,0,12" />
                                    <TextBlock Text="Custom profiles" Style="{StaticResource SettingsRowTitle}" />
                                    <TextBlock Text="Choose a saved writing profile, or create one inline."
                                               Style="{StaticResource SettingsRowDescription}" Margin="0,2,0,12" />

                                    <!-- Kept as a hidden compatibility selector for the settings model. -->
                                    <ComboBox x:Name="CustomProfileBox" Visibility="Collapsed"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectionChanged="CustomProfile_Changed" />
                                    <WrapPanel x:Name="CustomProfileCardsPanel" />
                                    <TextBlock x:Name="CustomProfileEmptyPlaceholder"
                                               Text="No saved profiles yet. Create your first one below."
                                               Foreground="{StaticResource Muted}" Margin="0,6,0,10"
                                               Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Content="New profile" Click="NewCustomProfile_Click" />
                                        <Button x:Name="EditCustomProfileButton" Content="Edit selected"
                                                Margin="8,0,0,0" Click="EditCustomProfile_Click" />
                                        <Button x:Name="DeleteCustomProfileButton" Content="Delete"
                                                Margin="8,0,0,0" Foreground="#B42318"
                                                Click="DeleteCustomProfile_Click" />
                                    </StackPanel>
                                    <Border x:Name="InlineDeleteConfirmation" Style="{StaticResource SettingsCard}"
                                            Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="InlineDeleteConfirmationText"
                                                       Text="Delete this profile?"
                                                       Foreground="{StaticResource Ink}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Cancel" Click="CancelDeleteCustomProfile_Click" />
                                                <Button Content="Delete" Margin="8,0,0,0"
                                                        Foreground="#B42318"
                                                        Click="ConfirmDeleteCustomProfile_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="InlineCustomProfileEditor" Style="{StaticResource SettingsCard}"
                                            Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="InlineCustomProfileEditorTitle"
                                                       Text="New custom profile" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Text="Give it a name and describe how the transcript should be rewritten."
                                                       Style="{StaticResource SettingsRowDescription}" Margin="0,2,0,10" />
                                            <TextBox x:Name="InlineCustomProfileNameBox" />
                                            <Grid Margin="0,8,0,0">
                                                <TextBox x:Name="InlineCustomProfileInstructionBox"
                                                         MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         VerticalContentAlignment="Top" Padding="12,7"
                                                         TextChanged="InlineCustomProfileInstruction_Changed" />
                                                <TextBlock x:Name="InlineCustomProfileInstructionHint"
                                                           Text="Rewrite in a friendly, concise tone."
                                                           Foreground="{StaticResource Muted}" Margin="12,7,12,0"
                                                           VerticalAlignment="Top"
                                                           TextWrapping="Wrap" IsHitTestVisible="False" />
                                            </Grid>
                                            <TextBlock x:Name="CustomProfileValidationText"
                                                       Foreground="#B42318" Margin="0,8,0,0"
                                                       TextWrapping="Wrap" Visibility="Collapsed" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button Content="Cancel" Click="CancelInlineCustomProfile_Click" />
                                                <Button Content="Save profile" Margin="8,0,0,0"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Click="SaveInlineCustomProfile_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RewritePipelineBadge"
                                Background="#EEF0F5" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="16" Margin="0,14,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#E2E5EB"
                                        CornerRadius="17" Margin="0,0,12,0">
                                    <TextBlock Text="✦" FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Luna · Low reasoning"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Sends the transcript to OpenAI in a second, non-persisted request. If rewriting fails, the original transcript is delivered."
                                               Style="{StaticResource SettingsRowDescription}"
                                               LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Rewrite modes add a second ChatGPT request. No rewrite is the fastest option."
                                   Foreground="{StaticResource Muted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="4,12,4,0" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Background="#F2F3F6" Padding="0,18,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="RewriteSavedText"
                                   Text="Changes are saved automatically."
                                   Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
